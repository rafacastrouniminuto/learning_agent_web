# Variables de entorno para Learning Agent Web - Living Lab UNIMINUTO
# Copia este archivo como .env y configura las variables reales

# OpenAI API Key (obtén tu clave de https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Configuración de desarrollo
DEBUG=True
SECRET_KEY=living-lab-secret-key-change-in-production-2025

# Configuración de la base de datos
DATABASE_URL=sqlite:///./learning_agent.db

# Configuración de OpenAI
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# Configuración de MCP
MCP_SERVER_NAME=learning-agent-mcp
MCP_SERVER_VERSION=1.0.0

# Configuración de CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Configuración de JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
