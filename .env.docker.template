# Variables de entorno para Docker - Learning Agent Web
# Copia este archivo como .env.docker y configura tus valores reales

# OpenAI Configuration (OBLIGATORIO - configurar con tu API key real)
OPENAI_API_KEY=your_openai_api_key_here

# Configuración del contenedor
COMPOSE_PROJECT_NAME=learning-agent-lab

# Puerto del servidor (cambiar si hay conflictos)
LEARNING_AGENT_PORT=8000

# Modo de desarrollo (cambiar a false en producción)
DEBUG_MODE=true

# Configuración de red (opcional)
REDIS_PORT=6379
